<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The only extra capability MacBridge asks for: sending Apple Events
         (Music/Spotify playback and restart/shutdown via loginwindow).
         macOS still asks the user before each target app can be controlled. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
