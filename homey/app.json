{
  "id": "no.kristo.macbridge",
  "version": "1.1.2",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Mac Bridge",
    "no": "Mac Bridge"
  },
  "description": {
    "en": "Control and monitor your Mac",
    "no": "Styr og overvåk Macen din"
  },
  "category": [
    "video"
  ],
  "permissions": [],
  "brandColor": "#1d1d1f",
  "author": {
    "name": "Sebastian Kristo",
    "email": "sebastian@kristo.no"
  },
  "source": "https://github.com/SebastianKristo/homey-homeassistant-mac",
  "homepage": "https://github.com/SebastianKristo/homey-homeassistant-mac",
  "support": "https://github.com/SebastianKristo/homey-homeassistant-mac/issues",
  "bugs": {
    "url": "https://github.com/SebastianKristo/homey-homeassistant-mac/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "discovery": {
    "macbridge": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "macbridge",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  },
  "capabilities": {
    "measure_cpu": {
      "type": "number",
      "title": {
        "en": "CPU usage",
        "no": "CPU-bruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_memory": {
      "type": "number",
      "title": {
        "en": "Memory usage",
        "no": "Minnebruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_disk": {
      "type": "number",
      "title": {
        "en": "Disk usage",
        "no": "Diskbruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_disk_free": {
      "type": "number",
      "title": {
        "en": "Disk free",
        "no": "Ledig disk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "GB"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "measure_load": {
      "type": "number",
      "title": {
        "en": "Load (1 min)",
        "no": "Last (1 min)"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "decimals": 2,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_thermal_state": {
      "type": "string",
      "title": {
        "en": "Thermal state",
        "no": "Temperaturstatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "wake",
        "title": {
          "en": "Wake the Mac (Wake-on-LAN)",
          "no": "Vekk Macen (Wake-on-LAN)"
        },
        "titleFormatted": {
          "en": "Wake the Mac (Wake-on-LAN)",
          "no": "Vekk Macen (Wake-on-LAN)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "sleep",
        "title": {
          "en": "Put the Mac to sleep",
          "no": "Sett Macen i dvale"
        },
        "titleFormatted": {
          "en": "Put the Mac to sleep",
          "no": "Sett Macen i dvale"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "display_sleep",
        "title": {
          "en": "Turn off the display",
          "no": "Slå av skjermen"
        },
        "titleFormatted": {
          "en": "Turn off the display",
          "no": "Slå av skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "wake_display",
        "title": {
          "en": "Wake the display",
          "no": "Vekk skjermen"
        },
        "titleFormatted": {
          "en": "Wake the display",
          "no": "Vekk skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "lock",
        "title": {
          "en": "Lock the screen",
          "no": "Lås skjermen"
        },
        "titleFormatted": {
          "en": "Lock the screen",
          "no": "Lås skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "restart",
        "title": {
          "en": "Restart the Mac",
          "no": "Start Macen på nytt"
        },
        "titleFormatted": {
          "en": "Restart the Mac",
          "no": "Start Macen på nytt"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "shutdown",
        "title": {
          "en": "Shut down the Mac",
          "no": "Slå av Macen"
        },
        "titleFormatted": {
          "en": "Shut down the Mac",
          "no": "Slå av Macen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "play_pause",
        "title": {
          "en": "Play/pause",
          "no": "Spill/pause"
        },
        "titleFormatted": {
          "en": "Play/pause",
          "no": "Spill/pause"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "next",
        "title": {
          "en": "Next track",
          "no": "Neste spor"
        },
        "titleFormatted": {
          "en": "Next track",
          "no": "Neste spor"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "previous",
        "title": {
          "en": "Previous track",
          "no": "Forrige spor"
        },
        "titleFormatted": {
          "en": "Previous track",
          "no": "Forrige spor"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "say",
        "title": {
          "en": "Speak text",
          "no": "Si tekst"
        },
        "titleFormatted": {
          "en": "Speak text [[value]]",
          "no": "Si tekst [[value]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          },
          {
            "type": "text",
            "name": "value",
            "title": {
              "en": "Text",
              "no": "Tekst"
            }
          }
        ]
      },
      {
        "id": "notify",
        "title": {
          "en": "Show notification",
          "no": "Vis varsel"
        },
        "titleFormatted": {
          "en": "Show notification [[value]]",
          "no": "Vis varsel [[value]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          },
          {
            "type": "text",
            "name": "value",
            "title": {
              "en": "Message",
              "no": "Melding"
            }
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "cpu_above",
        "title": {
          "en": "CPU usage went above…",
          "no": "CPU-bruk gikk over…"
        },
        "titleFormatted": {
          "en": "CPU usage went above [[threshold]]%",
          "no": "CPU-bruk gikk over [[threshold]]%"
        },
        "tokens": [
          {
            "name": "cpu",
            "type": "number",
            "title": {
              "en": "CPU",
              "no": "CPU"
            },
            "example": 85
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          },
          {
            "type": "number",
            "name": "threshold",
            "min": 0,
            "max": 100,
            "placeholder": {
              "en": "80",
              "no": "80"
            }
          }
        ]
      },
      {
        "id": "went_offline",
        "title": {
          "en": "Mac went offline",
          "no": "Macen gikk offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      },
      {
        "id": "came_online",
        "title": {
          "en": "Mac came online",
          "no": "Macen kom online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "mac_mini",
      "name": {
        "en": "Mac mini",
        "no": "Mac mini"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_prev",
        "speaker_next",
        "speaker_track",
        "speaker_artist",
        "speaker_album",
        "volume_set",
        "volume_mute",
        "measure_cpu",
        "measure_memory",
        "measure_disk",
        "measure_disk_free",
        "measure_load",
        "mac_thermal_state",
        "button.wake",
        "button.sleep",
        "button.restart",
        "button.shutdown"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Awake",
            "no": "Våken"
          }
        },
        "button.wake": {
          "title": {
            "en": "Wake",
            "no": "Vekk"
          },
          "maintenanceAction": false
        },
        "button.sleep": {
          "title": {
            "en": "Sleep",
            "no": "Dvale"
          },
          "maintenanceAction": false
        },
        "button.restart": {
          "title": {
            "en": "Restart",
            "no": "Start på nytt"
          },
          "maintenanceAction": false
        },
        "button.shutdown": {
          "title": {
            "en": "Shut down",
            "no": "Slå av"
          },
          "maintenanceAction": false
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "macbridge",
      "images": {
        "small": "/drivers/mac_mini/assets/images/small.png",
        "large": "/drivers/mac_mini/assets/images/large.png",
        "xlarge": "/drivers/mac_mini/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "configure"
        }
      ],
      "repair": [
        {
          "id": "configure"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "Host",
            "no": "Vert"
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "value": 8765
        },
        {
          "id": "token",
          "type": "password",
          "label": {
            "en": "Token",
            "no": "Token"
          },
          "value": ""
        },
        {
          "id": "interval",
          "type": "number",
          "label": {
            "en": "Polling interval (s)",
            "no": "Oppdateringsintervall (s)"
          },
          "value": 10,
          "min": 2,
          "max": 600
        }
      ]
    },
    {
      "id": "macbook_pro",
      "name": {
        "en": "MacBook Pro",
        "no": "MacBook Pro"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_prev",
        "speaker_next",
        "speaker_track",
        "speaker_artist",
        "speaker_album",
        "volume_set",
        "volume_mute",
        "measure_cpu",
        "measure_memory",
        "measure_disk",
        "measure_disk_free",
        "measure_load",
        "mac_thermal_state",
        "measure_battery",
        "button.wake",
        "button.sleep",
        "button.restart",
        "button.shutdown"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Awake",
            "no": "Våken"
          }
        },
        "button.wake": {
          "title": {
            "en": "Wake",
            "no": "Vekk"
          },
          "maintenanceAction": false
        },
        "button.sleep": {
          "title": {
            "en": "Sleep",
            "no": "Dvale"
          },
          "maintenanceAction": false
        },
        "button.restart": {
          "title": {
            "en": "Restart",
            "no": "Start på nytt"
          },
          "maintenanceAction": false
        },
        "button.shutdown": {
          "title": {
            "en": "Shut down",
            "no": "Slå av"
          },
          "maintenanceAction": false
        }
      },
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "macbridge",
      "images": {
        "small": "/drivers/macbook_pro/assets/images/small.png",
        "large": "/drivers/macbook_pro/assets/images/large.png",
        "xlarge": "/drivers/macbook_pro/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "configure"
        }
      ],
      "repair": [
        {
          "id": "configure"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "Host",
            "no": "Vert"
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "value": 8765
        },
        {
          "id": "token",
          "type": "password",
          "label": {
            "en": "Token",
            "no": "Token"
          },
          "value": ""
        },
        {
          "id": "interval",
          "type": "number",
          "label": {
            "en": "Polling interval (s)",
            "no": "Oppdateringsintervall (s)"
          },
          "value": 10,
          "min": 2,
          "max": 600
        }
      ]
    }
  ]
}
