{
  "id": "no.kristo.macbridge",
  "version": "1.3.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Mac Bridge",
    "no": "Mac Bridge"
  },
  "description": {
    "en": "Control and monitor your Mac or Windows PC",
    "no": "Styr og overvåk Macen eller Windows-PC-en din"
  },
  "category": [
    "video"
  ],
  "permissions": [],
  "brandColor": "#1d1d1f",
  "author": {
    "name": "Sebastian Kristo",
    "email": "sebastian@kristo.no"
  },
  "source": "https://github.com/SebastianKristo/homey-homeassistant-mac",
  "homepage": "https://github.com/SebastianKristo/homey-homeassistant-mac",
  "support": "https://github.com/SebastianKristo/homey-homeassistant-mac/issues",
  "bugs": {
    "url": "https://github.com/SebastianKristo/homey-homeassistant-mac/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "discovery": {
    "macbridge": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "macbridge",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  },
  "capabilities": {
    "measure_cpu": {
      "type": "number",
      "title": {
        "en": "CPU usage",
        "no": "CPU-bruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_memory": {
      "type": "number",
      "title": {
        "en": "Memory usage",
        "no": "Minnebruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_disk": {
      "type": "number",
      "title": {
        "en": "Disk usage",
        "no": "Diskbruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "min": 0,
      "max": 100,
      "icon": "/assets/icon.svg"
    },
    "measure_disk_free": {
      "type": "number",
      "title": {
        "en": "Disk free",
        "no": "Ledig disk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "GB"
      },
      "insights": true,
      "decimals": 1,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "measure_load": {
      "type": "number",
      "title": {
        "en": "Load (1 min)",
        "no": "Last (1 min)"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "decimals": 2,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_thermal_state": {
      "type": "string",
      "title": {
        "en": "Thermal state",
        "no": "Temperaturstatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_active_app": {
      "type": "string",
      "title": {
        "en": "Active app",
        "no": "Aktiv app"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_logged_user": {
      "type": "string",
      "title": {
        "en": "Logged in user",
        "no": "Innlogget bruker"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_idle_minutes": {
      "type": "number",
      "title": {
        "en": "Idle time",
        "no": "Inaktiv tid"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "min"
      },
      "decimals": 0,
      "min": 0,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "measure_gpu": {
      "type": "number",
      "title": {
        "en": "GPU usage",
        "no": "GPU-bruk"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "min": 0,
      "max": 100,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mac_locked": {
      "type": "boolean",
      "title": {
        "en": "Locked",
        "no": "Låst"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "insightsTitleTrue": {
        "en": "Locked",
        "no": "Låst"
      },
      "insightsTitleFalse": {
        "en": "Unlocked",
        "no": "Ulåst"
      }
    },
    "mac_display_on": {
      "type": "boolean",
      "title": {
        "en": "Display on",
        "no": "Skjerm på"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "insightsTitleTrue": {
        "en": "Display on",
        "no": "Skjerm på"
      },
      "insightsTitleFalse": {
        "en": "Display off",
        "no": "Skjerm av"
      }
    },
    "mac_microphone_active": {
      "type": "boolean",
      "title": {
        "en": "Microphone in use",
        "no": "Mikrofon i bruk"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "insightsTitleTrue": {
        "en": "Microphone on",
        "no": "Mikrofon på"
      },
      "insightsTitleFalse": {
        "en": "Microphone off",
        "no": "Mikrofon av"
      }
    },
    "mac_webcam_active": {
      "type": "boolean",
      "title": {
        "en": "Webcam in use",
        "no": "Kamera i bruk"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "insightsTitleTrue": {
        "en": "Webcam on",
        "no": "Kamera på"
      },
      "insightsTitleFalse": {
        "en": "Webcam off",
        "no": "Kamera av"
      }
    }
  },
  "flow": {
    "actions": [
      {
        "id": "wake",
        "title": {
          "en": "Wake (Wake-on-LAN)",
          "no": "Vekk (Wake-on-LAN)"
        },
        "titleFormatted": {
          "en": "Wake (Wake-on-LAN)",
          "no": "Vekk (Wake-on-LAN)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "sleep",
        "title": {
          "en": "Put to sleep",
          "no": "Sett i dvale"
        },
        "titleFormatted": {
          "en": "Put to sleep",
          "no": "Sett i dvale"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "display_sleep",
        "title": {
          "en": "Turn off the display",
          "no": "Slå av skjermen"
        },
        "titleFormatted": {
          "en": "Turn off the display",
          "no": "Slå av skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "wake_display",
        "title": {
          "en": "Wake the display",
          "no": "Vekk skjermen"
        },
        "titleFormatted": {
          "en": "Wake the display",
          "no": "Vekk skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "lock",
        "title": {
          "en": "Lock the screen",
          "no": "Lås skjermen"
        },
        "titleFormatted": {
          "en": "Lock the screen",
          "no": "Lås skjermen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "restart",
        "title": {
          "en": "Restart",
          "no": "Start på nytt"
        },
        "titleFormatted": {
          "en": "Restart",
          "no": "Start på nytt"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "shutdown",
        "title": {
          "en": "Shut down",
          "no": "Slå av"
        },
        "titleFormatted": {
          "en": "Shut down",
          "no": "Slå av"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "play_pause",
        "title": {
          "en": "Play/pause",
          "no": "Spill/pause"
        },
        "titleFormatted": {
          "en": "Play/pause",
          "no": "Spill/pause"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "next",
        "title": {
          "en": "Next track",
          "no": "Neste spor"
        },
        "titleFormatted": {
          "en": "Next track",
          "no": "Neste spor"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "previous",
        "title": {
          "en": "Previous track",
          "no": "Forrige spor"
        },
        "titleFormatted": {
          "en": "Previous track",
          "no": "Forrige spor"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "say",
        "title": {
          "en": "Speak text",
          "no": "Si tekst"
        },
        "titleFormatted": {
          "en": "Speak text [[value]]",
          "no": "Si tekst [[value]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          },
          {
            "type": "text",
            "name": "value",
            "title": {
              "en": "Text",
              "no": "Tekst"
            }
          }
        ]
      },
      {
        "id": "notify",
        "title": {
          "en": "Show notification",
          "no": "Vis varsel"
        },
        "titleFormatted": {
          "en": "Show notification [[value]]",
          "no": "Vis varsel [[value]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          },
          {
            "type": "text",
            "name": "value",
            "title": {
              "en": "Message",
              "no": "Melding"
            }
          }
        ]
      },
      {
        "id": "notify_buttons",
        "title": {
          "en": "Show notification with buttons",
          "no": "Vis varsel med knapper"
        },
        "titleFormatted": {
          "en": "Show notification [[title]]: [[message]] with buttons [[buttons]]",
          "no": "Vis varsel [[title]]: [[message]] med knappene [[buttons]]"
        },
        "hint": {
          "en": "Buttons are separated by commas (max 4). A click starts the 'A notification button was clicked' flow.",
          "no": "Knappene skilles med komma (maks 4). Et trykk starter flowen «En varselknapp ble trykket»."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          },
          {
            "type": "text",
            "name": "title",
            "title": {
              "en": "Title",
              "no": "Tittel"
            },
            "placeholder": {
              "en": "Home",
              "no": "Hjem"
            }
          },
          {
            "type": "text",
            "name": "message",
            "title": {
              "en": "Message",
              "no": "Melding"
            }
          },
          {
            "type": "text",
            "name": "buttons",
            "title": {
              "en": "Buttons",
              "no": "Knapper"
            },
            "placeholder": {
              "en": "Yes, No",
              "no": "Ja, Nei"
            }
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "cpu_above",
        "title": {
          "en": "CPU usage went above…",
          "no": "CPU-bruk gikk over…"
        },
        "titleFormatted": {
          "en": "CPU usage went above [[threshold]]%",
          "no": "CPU-bruk gikk over [[threshold]]%"
        },
        "tokens": [
          {
            "name": "cpu",
            "type": "number",
            "title": {
              "en": "CPU",
              "no": "CPU"
            },
            "example": 85
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          },
          {
            "type": "number",
            "name": "threshold",
            "min": 0,
            "max": 100,
            "placeholder": {
              "en": "80",
              "no": "80"
            }
          }
        ]
      },
      {
        "id": "went_offline",
        "title": {
          "en": "Went offline",
          "no": "Gikk offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "came_online",
        "title": {
          "en": "Came online",
          "no": "Kom online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "notification_button",
        "title": {
          "en": "A notification button was clicked",
          "no": "En varselknapp ble trykket"
        },
        "titleFormatted": {
          "en": "A notification button was clicked",
          "no": "En varselknapp ble trykket"
        },
        "tokens": [
          {
            "name": "button",
            "type": "string",
            "title": {
              "en": "Button",
              "no": "Knapp"
            },
            "example": "Ja"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Notification title",
              "no": "Varseltittel"
            },
            "example": "Støvsuger"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "state_changed",
        "title": {
          "en": "System state changed",
          "no": "Systemtilstand endret"
        },
        "tokens": [
          {
            "name": "state",
            "type": "string",
            "title": {
              "en": "State",
              "no": "Tilstand"
            },
            "example": "locked"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "locked_changed",
        "title": {
          "en": "Was locked or unlocked",
          "no": "Ble låst eller låst opp"
        },
        "tokens": [
          {
            "name": "locked",
            "type": "boolean",
            "title": {
              "en": "Locked",
              "no": "Låst"
            },
            "example": true
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "microphone_changed",
        "title": {
          "en": "Microphone turned on or off",
          "no": "Mikrofon ble slått på eller av"
        },
        "tokens": [
          {
            "name": "active",
            "type": "boolean",
            "title": {
              "en": "In use",
              "no": "I bruk"
            },
            "example": true
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "webcam_changed",
        "title": {
          "en": "Webcam turned on or off",
          "no": "Kamera ble slått på eller av"
        },
        "tokens": [
          {
            "name": "active",
            "type": "boolean",
            "title": {
              "en": "In use",
              "no": "I bruk"
            },
            "example": true
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_locked",
        "title": {
          "en": "Is !{{locked|unlocked}}",
          "no": "Er !{{låst|ulåst}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "microphone_active",
        "title": {
          "en": "Microphone !{{is|is not}} in use",
          "no": "Mikrofonen !{{er|er ikke}} i bruk"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      },
      {
        "id": "webcam_active",
        "title": {
          "en": "Webcam !{{is|is not}} in use",
          "no": "Kameraet !{{er|er ikke}} i bruk"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mac_mini|macbook_pro|windows_pc"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "mac_mini",
      "name": {
        "en": "Mac mini",
        "no": "Mac mini"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_prev",
        "speaker_next",
        "speaker_track",
        "speaker_artist",
        "speaker_album",
        "volume_set",
        "volume_mute",
        "measure_cpu",
        "measure_memory",
        "measure_disk",
        "measure_disk_free",
        "measure_load",
        "mac_thermal_state",
        "button.wake",
        "button.sleep",
        "button.restart",
        "button.shutdown"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Awake",
            "no": "Våken"
          }
        },
        "button.wake": {
          "title": {
            "en": "Wake",
            "no": "Vekk"
          },
          "maintenanceAction": false
        },
        "button.sleep": {
          "title": {
            "en": "Sleep",
            "no": "Dvale"
          },
          "maintenanceAction": false
        },
        "button.restart": {
          "title": {
            "en": "Restart",
            "no": "Start på nytt"
          },
          "maintenanceAction": false
        },
        "button.shutdown": {
          "title": {
            "en": "Shut down",
            "no": "Slå av"
          },
          "maintenanceAction": false
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "macbridge",
      "images": {
        "small": "/drivers/mac_mini/assets/images/small.png",
        "large": "/drivers/mac_mini/assets/images/large.png",
        "xlarge": "/drivers/mac_mini/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "configure"
        }
      ],
      "repair": [
        {
          "id": "configure"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "Host",
            "no": "Vert"
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "value": 8765
        },
        {
          "id": "token",
          "type": "password",
          "label": {
            "en": "Token",
            "no": "Token"
          },
          "value": ""
        },
        {
          "id": "interval",
          "type": "number",
          "label": {
            "en": "Polling interval (s)",
            "no": "Oppdateringsintervall (s)"
          },
          "value": 10,
          "min": 2,
          "max": 600
        }
      ]
    },
    {
      "id": "macbook_pro",
      "name": {
        "en": "MacBook Pro",
        "no": "MacBook Pro"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_prev",
        "speaker_next",
        "speaker_track",
        "speaker_artist",
